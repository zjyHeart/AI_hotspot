{
  "name": "signal-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "worker": "node --use-env-proxy --import tsx scripts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@next/env": "16.3.8",
    "@tailwindcss/postcss": "4.3.3",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "5.11.2",
    "jsdom": "30.1.2",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
