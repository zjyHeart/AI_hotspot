# Copy to .env.local. Never share or commit actual credentials.
APP_URL=http://localhost:3000
DATABASE_URL=file:./data/hotspot.db
PACKY_API_KEY=
# Official recommended endpoint; the platform domain is configurable in Settings.
PACKY_BASE_URL=https://cf.api.fan/v1
# Fill the model ID shown for your token group.
AI_MODEL=
AI_OUTPUT_MODE=json_object
TWITTERAPI_API_KEY=
GITHUB_TOKEN=
# One key for Google and Bing; never paste a secret into chat.
SERPAPI_API_KEY=
SCAN_INTERVAL_MINUTES=30
SCAN_MAX_PAGES=3
AI_BATCH_SIZE=3
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# 本机 X 连续请求间隔，默认 6 秒；预算在设置页面调整
X_REQUEST_INTERVAL_MS=6000
